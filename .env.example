# Set COOKIE_SECURE=true behind HTTPS. Local HTTP development should leave it unset.
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional SMS delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional email delivery (EmailJS REST API)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Server-side route instruction summaries (keep this key private)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local admin account credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
